# Demo works without any secret. Copy this file to .env only to change defaults.
APP_MODE=demo
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./data/decidr.db
DEMO_AUTOLOAD=true
SCHEDULER_ENABLED=true

# Safety policy. Live starts with no trusted senders: all messages require review.
KNOWN_SENDERS=
MAX_AMOUNT=1000
ALLOWED_CURRENCY=PLN
MIN_CONFIDENCE=0.9

# Live only: generate different secrets locally; never commit .env.
APP_PASSWORD=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=false

# Optional OpenAI Structured Outputs (live). Model can be overridden.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Google OAuth web application (live).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/oauth/gmail/callback
GMAIL_QUERY=in:inbox newer_than:7d -from:me
SYNC_INTERVAL_SECONDS=120

# Optional browser push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
