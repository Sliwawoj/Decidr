# Demo works without secrets. Copy to .env only when you need live mode.
APP_MODE=demo
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./data/decidr.db
DEMO_AUTOLOAD=true
SCHEDULER_ENABLED=true

# Live only
APP_PASSWORD=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/oauth/gmail/callback
GMAIL_QUERY=in:inbox -from:me
SYNC_INTERVAL_SECONDS=30

# PUBLIC ≈ 87 chars (often BP…); PRIVATE ≈ 43 chars. Generate: python scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
